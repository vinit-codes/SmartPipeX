{
  "name": "smartpipex",
  "version": "1.0.0",
  "private": true,
  "description": "Hardware-tested ESP32 pipeline leak monitoring platform built with Next.js and MongoDB.",
  "author": "Vineeth Kundu",
  "license": "MIT",
  "homepage": "https://smart-pipe-x-git-main-vineeth-kundus-projects.vercel.app/",
  "keywords": [
    "esp32",
    "iot",
    "nextjs",
    "typescript",
    "mongodb",
    "leak-detection",
    "pwa"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run type-check && npm run test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "mongodb": "^7.0.0",
    "next": "^16.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.5.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "packageManager": "npm@10.9.2",
  "type": "module"
}
