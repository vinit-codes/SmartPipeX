# Public application URL used for metadata and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for real ESP32 telemetry. Read-only dashboard routes fall back to
# labelled simulation data when MongoDB is not configured.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=smartpipex

# Protects POST /api/ingest in production. Send it as the x-api-key header.
INGEST_API_KEY=replace-with-a-long-random-secret

# Optional demo, device, and leak-detection configuration.
# Keep false in real monitoring deployments so database outages fail visibly.
ENABLE_SIMULATION_FALLBACK=false
DEFAULT_DEVICE_ID=ESP32_DEV_PIPELINE_001
LEAK_THRESHOLD_LPM=0.3
